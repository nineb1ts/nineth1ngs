<Window x:Class="nineth1ngs.Views.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete th1ng"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="8"
            Padding="22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <TextBlock Text="Delete th1ng?"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Margin="0,8,0,0"
                       Text="This cannot be undone."
                       FontFamily="Segoe UI Variable Small"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Border Margin="0,14,0,0"
                    Padding="12"
                    Background="{StaticResource SurfaceHighlightBrush}"
                    CornerRadius="10">
                <TextBlock Text="{Binding Th1ngText}"
                           TextWrapping="Wrap"
                           MaxHeight="60"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="13"
                           Foreground="{StaticResource PrimaryTextBrush}" />
            </Border>
            <StackPanel Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="CancelClick"
                    Style="{StaticResource DialogButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Delete"
                        Click="DeleteClick"
                    Style="{StaticResource DangerDialogButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
