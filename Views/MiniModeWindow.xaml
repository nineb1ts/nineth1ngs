<Window x:Class="nineth1ngs.Views.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="nineth1ngs mini mode"
        Width="440"
        Height="86"
        MinWidth="360"
        MinHeight="86"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MiniTimerButtonStyle"
               BasedOn="{StaticResource AddButtonStyle}"
               TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TimerButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TimerButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="TimerButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="TimerButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding MiniDisplayedTh1ng}"
                             Value="{x:Null}">
                    <Setter Property="IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filled timer icons -->
        <PathGeometry x:Key="FilledPlayGeometry"
                      Figures="M6,4 L20,12 L6,20 Z"/>

        <GeometryGroup x:Key="FilledPauseGeometry">
            <RectangleGeometry Rect="6,4,4,16"
                               RadiusX="1"
                               RadiusY="1"/>
            <RectangleGeometry Rect="14,4,4,16"
                               RadiusX="1"
                               RadiusY="1"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherMaximizeGeometry">
            <PathGeometry Figures="M8,3 L3,3 L3,8"/>
            <PathGeometry Figures="M16,3 L21,3 L21,8"/>
            <PathGeometry Figures="M8,21 L3,21 L3,16"/>
            <PathGeometry Figures="M16,21 L21,21 L21,16"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherGripGeometry">
            <EllipseGeometry Center="8,7"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="16,7"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="8,12"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="16,12"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="8,17"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="16,17"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="8,22"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
            <EllipseGeometry Center="16,22"
                             RadiusX="1.2"
                             RadiusY="1.2"/>
        </GeometryGroup>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MINI MODE -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT RAIL -->

                <Border x:Name="RailHoverZone"
                        Grid.Column="0"
                        Background="Transparent"
                        MouseEnter="RailHoverZoneMouseEnter"
                        MouseLeave="RailHoverZoneMouseLeave"
                        MouseLeftButtonDown="MiniDragAreaMouseLeftButtonDown">

                    <Grid x:Name="RailControls"
                          Opacity="0"
                          IsHitTestVisible="False"
                          RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                            <TranslateTransform X="-8"/>
                        </Grid.RenderTransform>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- RETURN TO NORMAL MODE -->

                        <Button Grid.Row="0"
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                Click="ReturnToNormalClick"
                                ToolTip="Return to normal mode"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Focusable="False"
                                Cursor="Hand">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>

                            <Viewbox Width="16"
                                     Height="16">
                                <Path Data="{StaticResource FeatherMaximizeGeometry}"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                        </Button>

                        <!-- DRAG HANDLE -->

                        <Viewbox Grid.Row="1"
                                 Width="18"
                                 Height="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="-8,0,0,10">

                            <Path Data="{StaticResource FeatherGripGeometry}"
                                  Fill="{StaticResource AccentBrush}"/>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- TH1NG + TIMER -->

                <Grid Grid.Column="1"
                      Margin="4,11,6,10"
                      VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding MiniDisplayedTh1ng.Text, TargetNullValue=No open th1ngs}"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,3,0,0"
                               Text="{Binding MiniDisplayedTh1ng.ElapsedTimeText, TargetNullValue=--:--}"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Grid>

                <!-- PLAY / PAUSE -->

                <Button Grid.Column="2"
                        Width="38"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleTimerCommand}"
                        CommandParameter="{Binding MiniDisplayedTh1ng}"
                        Style="{StaticResource MiniTimerButtonStyle}"
                        ToolTip="Start or pause timer">

                    <Grid Width="16"
                          Height="18">

                        <!-- PLAY -->

                        <Viewbox Stretch="Uniform"
                                 Margin="-2,-2,0,0">

                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MiniDisplayedTh1ng.IsTimerRunning}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>

                            <Path Data="{StaticResource FilledPlayGeometry}"
                                  Fill="{StaticResource WindowBackgroundBrush}"
                                  StrokeThickness="0"/>
                        </Viewbox>

                        <!-- PAUSE -->

                        <Viewbox Stretch="Uniform"
                                 Margin="-5,-2,0,0">

                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MiniDisplayedTh1ng.IsTimerRunning}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>

                            <Path Data="{StaticResource FilledPauseGeometry}"
                                  Fill="{StaticResource WindowBackgroundBrush}"
                                  StrokeThickness="0"/>
                        </Viewbox>
                    </Grid>
                </Button>
            </Grid>

            <!-- QUICK INPUT -->

            <Grid x:Name="QuickInputArea"
                  Grid.Row="1"
                  Height="46"
                  Margin="46,0,14,2"
                  Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT -->

                <Border Grid.Column="0"
                        Margin="0,2,8,6"
                        Padding="0,0,0,3"
                        Background="Transparent"
                        BorderThickness="0,0,0,1">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderBrush}"/>

                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <TextBlock Text="Add a th1ng..."
                                   Margin="0,0,0,1"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Small"
                                   FontSize="15"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   IsHitTestVisible="False">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickInputTextBox}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="QuickInputTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 FontFamily="Segoe UI Variable Small"
                                 FontSize="15"
                                 TextChanged="QuickInputTextBoxTextChanged"
                                 KeyDown="QuickInputTextBoxKeyDown"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>