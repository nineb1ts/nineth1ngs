<Window x:Class="nineth1ngs.Views.SessionTimeReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review session time"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="SessionComboBoxItemStyle"
               TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource SessionComboBoxItemStyle}"/>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">

        <StackPanel>
            <TextBlock Text="You were away"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <TextBlock Margin="0,8,0,0"
                       Text="{Binding AwayTimeText}"
                       FontFamily="Segoe UI Variable Small"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

            <TextBlock Margin="0,18,0,7"
                       Text="Where should this time go?"
                       FontFamily="Segoe UI Variable Small"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

            <ComboBox ItemsSource="{Binding AvailableTh1ngs}"
                      SelectedItem="{Binding SelectedTh1ng}"
                      DisplayMemberPath="Text"
                      Style="{StaticResource SessionComboBoxStyle}"/>

            <TextBlock Margin="0,10,0,0"
                       Text="The timer was paused when Windows was locked. Discarding this only discards the time spent away."
                       TextWrapping="Wrap"
                       FontFamily="Segoe UI Variable Small"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <StackPanel Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Discard"
                        Click="DiscardClick"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="0,0,12,0"/>

                <Button Content="Add time"
                        Click="AddTimeClick"
                        Style="{StaticResource DialogButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
