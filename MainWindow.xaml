<Window x:Class="nineth1ngs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:services="clr-namespace:nineth1ngs.Services"
        mc:Ignorable="d"
        Title="nineth1ngs"
        Width="520"
        Height="720"
        MinWidth="400"
        MinHeight="520"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <services:TimestampDisplayConverter x:Key="TimestampConverter" />
        <Style x:Key="OpenSectionButtonStyle"
               BasedOn="{StaticResource SectionButtonStyle}"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="done">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DoneSectionButtonStyle"
               BasedOn="{StaticResource SectionButtonStyle}"
               TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="done">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpenSectionVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="done">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DoneSectionVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}" Value="done">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Th1ngTemplate">
                <Border Margin="0"
                    Padding="11,8"
                    Style="{StaticResource Th1ngItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MinWidth="0">
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource TimestampConverter}}"
                                   Style="{StaticResource TimestampStyle}" />
                        <TextBlock Text="{Binding Text}"
                                   Style="{StaticResource Th1ngTextStyle}">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource InlineEditTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SaveEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                <KeyBinding Key="Escape"
                                            Command="{Binding DataContext.CancelEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding ElapsedTimeText}"
                                   Margin="0,2,0,0"
                                   FontFamily="Segoe UI Variable Small"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CompletionIconButtonStyle}"
                                Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Start or pause timer">
                            <Grid Width="15" Height="15">
                                <Path Data="{StaticResource PlayGeometry}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource PauseGeometry}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CompletionIconButtonStyle}"
                                Command="{Binding DataContext.ToggleCompletionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Complete or reopen th1ng">
                            <Grid Width="15" Height="15">
                                <Path x:Name="CheckIcon"
                                      Data="{StaticResource CheckGeometry}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path x:Name="ReopenIcon"
                                      Data="{StaticResource ReopenArrowGeometry}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource DangerIconButtonStyle}"
                                Command="{Binding DataContext.DeleteTh1ngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Delete th1ng">
                            <Path Data="{StaticResource CloseGeometry}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
        <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource ChromeBrush}"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <svgc:SvgViewbox Width="25"
                         Height="25"
                         Stretch="Uniform"
                         Source="logo.svg"
                         ToolTip="nineth1ngs logo" />
                <TextBlock Margin="8,0,0,1"
                           Text="nineth1ngs"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="0,6,8,6"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="MinimizeClick"
                        Style="{StaticResource WindowButtonStyle}"
                        ToolTip="Minimize">
                    <Path Data="{StaticResource MinimizeGeometry}"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round" />
                </Button>
                <Button Click="MaximizeClick"
                        Style="{StaticResource WindowButtonStyle}"
                        ToolTip="Maximize or restore">
                    <Path Data="{StaticResource MaximizeGeometry}"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.2" />
                </Button>
                <Button Click="CloseClick"
                        Style="{StaticResource WindowButtonStyle}"
                        ToolTip="Close">
                    <Path Data="{StaticResource CloseGeometry}"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="18,0">
            <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Command="{Binding ShowOpenCommand}"
                        Style="{StaticResource OpenSectionButtonStyle}"
                        ToolTip="Show open th1ngs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TH1NGS" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding OpenTh1ngs.Count}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowDoneCommand}"
                        Style="{StaticResource DoneSectionButtonStyle}"
                        ToolTip="Show completed th1ngs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DONE" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DoneTh1ngs.Count}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Padding="18,0,18,8"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <Grid>
                <Grid Style="{StaticResource OpenSectionVisibilityStyle}">
                    <TextBlock Text="Nothing is waiting."
                               Margin="0,28"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpenTh1ngs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding OpenTh1ngs}"
                                  ItemTemplate="{StaticResource Th1ngTemplate}" />
                </Grid>
                <Grid Style="{StaticResource DoneSectionVisibilityStyle}">
                    <TextBlock Text="Nothing done yet."
                               Margin="0,28"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DoneTh1ngs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DoneTh1ngs}"
                                  ItemTemplate="{StaticResource Th1ngTemplate}" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
            Margin="18,6,18,10"
            Padding="10,4,6,4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid MinHeight="34">
                <TextBlock Text="Add a new th1ng..."
                           Margin="3,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Small"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewTh1ngText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewTh1ngText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             FontFamily="Segoe UI Variable Small"
                             FontSize="13"
                             CaretBrush="{StaticResource AccentBrush}"
                             ToolTip="Write a new th1ng">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTh1ngCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding AddTh1ngCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            ToolTip="Add th1ng">
                        <Path Data="{StaticResource AddGeometry}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
