<Window x:Class="nineth1ngs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:nineth1ngs.Services"
        mc:Ignorable="d"
        Title="nineth1ngs"
        Width="520"
        Height="720"
        MinWidth="400"
        MinHeight="575"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseDown="WindowPreviewMouseDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <services:TimestampDisplayConverter x:Key="TimestampConverter"/>

        <!-- Feather icon geometries (24x24 viewBox) -->
        <GeometryGroup x:Key="FeatherListGeometry">
            <PathGeometry Figures="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18"/>
            <EllipseGeometry Center="3,6"
                             RadiusX="0.75"
                             RadiusY="0.75"/>
            <EllipseGeometry Center="3,12"
                             RadiusX="0.75"
                             RadiusY="0.75"/>
            <EllipseGeometry Center="3,18"
                             RadiusX="0.75"
                             RadiusY="0.75"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherCheckCircleGeometry">
            <EllipseGeometry Center="12,12"
                             RadiusX="9"
                             RadiusY="9"/>
            <PathGeometry Figures="M8,12 L11,15 L16,9"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherSettingsGeometry">
            <EllipseGeometry Center="12,12"
                             RadiusX="3"
                             RadiusY="3"/>
            <PathGeometry Figures="M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 1 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14,20.83 L14,21 A2,2 0 1 1 10,21 L10,20.91 A1.65,1.65 0 0 0 8.92,19.4 A1.65,1.65 0 0 0 7.1,19.73 L7.04,19.79 A2,2 0 1 1 4.21,16.96 L4.27,16.9 A1.65,1.65 0 0 0 4.6,15.08 A1.65,1.65 0 0 0 3.09,14 L3,14 A2,2 0 1 1 3,10 L3.09,10 A1.65,1.65 0 0 0 4.6,8.92 A1.65,1.65 0 0 0 4.27,7.1 L4.21,7.04 A2,2 0 1 1 7.04,4.21 L7.1,4.27 A1.65,1.65 0 0 0 8.92,4.6 L10,4.6 L10,3 A2,2 0 1 1 14,3 L14,3.09 A1.65,1.65 0 0 0 15.08,4.6 A1.65,1.65 0 0 0 16.9,4.27 L16.96,4.21 A2,2 0 1 1 19.79,7.04 L19.73,7.1 A1.65,1.65 0 0 0 19.4,8.92 A1.65,1.65 0 0 0 20.91,10 L21,10 A2,2 0 1 1 21,14 L20.91,14 A1.65,1.65 0 0 0 19.4,15 Z"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherChevronLeftGeometry">
            <PathGeometry Figures="M15,18 L9,12 L15,6"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherCheckGeometry">
            <PathGeometry Figures="M20,6 L9,17 L4,12"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherXGeometry">
            <PathGeometry Figures="M18,6 L6,18 M6,6 L18,18"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherRotateCcwGeometry">
            <PathGeometry Figures="M1,4 L1,10 L7,10 M3.51,15 A9,9 0 1 0 5.64,5.64 L1,10"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherCopyGeometry">
            <RectangleGeometry Rect="9,9,13,13"
                               RadiusX="2"
                               RadiusY="2"/>
            <PathGeometry Figures="M5,15 L4,15 A2,2 0 0 1 2,13 L2,4 A2,2 0 0 1 4,2 L13,2 A2,2 0 0 1 15,4 L15,5"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherTrashGeometry">
            <PathGeometry Figures="M3,6 L5,6 L21,6 M8,6 L8,4 A2,2 0 0 1 10,2 L14,2 A2,2 0 0 1 16,4 L16,6 M19,6 L18,21 A2,2 0 0 1 16,23 L8,23 A2,2 0 0 1 6,21 L5,6 M10,11 L10,17 M14,11 L14,17"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherPlayGeometry">
            <PathGeometry Figures="M5,3 L19,12 L5,21 Z"/>
        </GeometryGroup>

        <GeometryGroup x:Key="FeatherPauseGeometry">
            <RectangleGeometry Rect="6,4,4,16"
                               RadiusX="1"
                               RadiusY="1"/>
            <RectangleGeometry Rect="14,4,4,16"
                               RadiusX="1"
                               RadiusY="1"/>
        </GeometryGroup>


        <Style x:Key="OpenSectionButtonStyle"
               BasedOn="{StaticResource SectionButtonStyle}"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="done">
                    <Setter Property="Foreground"
                            Value="{StaticResource MutedTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoneSectionButtonStyle"
               BasedOn="{StaticResource SectionButtonStyle}"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="done">
                    <Setter Property="Foreground"
                            Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenSectionVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="th1ngs">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoneSectionVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="done">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSectionVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="settings">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainNavigationVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="settings">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsNavigationVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="settings">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddTh1ngAreaVisibilityStyle"
               TargetType="Border">
            <Setter Property="Visibility"
                    Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection}"
                             Value="settings">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="SettingsComboBoxItemStyle"
               TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource SecondaryTextBrush}"
                                          Data="M 0,0 L 4,4 L 8,0 Z"/>
                                </Grid>
                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Small"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CaretBrush"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="10,0,72,0"
                                              VerticalAlignment="Center"/>

                                <TextBlock Margin="0,0,12,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="minutes"
                                           FontFamily="Segoe UI Variable Small"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- SUB-TH1NG                                                 -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="SubTh1ngTemplate">
            <Grid x:Name="SubTh1ngRow"
                  Margin="22,1,8,1"
                  MinHeight="30"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      MinWidth="0">
                    <TextBlock Text="{Binding Text}"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="16"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextDecorations"
                                        Value="{x:Null}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="Opacity"
                                                Value="0.45"/>
                                        <Setter Property="TextDecorations"
                                                Value="Strikethrough"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.BeginEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             FontFamily="Segoe UI Variable Small"
                             FontSize="16"
                             Margin="0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             IsVisibleChanged="EditTextBoxIsVisibleChanged">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource InlineEditTextBoxStyle}"
                                   TargetType="TextBox">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding DataContext.SaveEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape"
                                        Command="{Binding DataContext.CancelEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity"
                                    Value="0"/>
                            <Setter Property="IsHitTestVisible"
                                    Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubTh1ngRow}"
                                             Value="True">
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                    <Setter Property="IsHitTestVisible"
                                            Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Style="{StaticResource CompletionIconButtonStyle}"
                            Command="{Binding DataContext.ToggleCompletionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Complete or reopen sub-th1ng">
                        <Grid Width="15"
                              Height="15">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="-2,-2,0,0"
                                     Stretch="Uniform">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Path Data="{StaticResource FeatherCheckGeometry}"
                                      Fill="Transparent"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>

                            <Viewbox Width="15"
                                     Height="15"
                                     Stretch="Uniform">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Path Data="{StaticResource FeatherRotateCcwGeometry}"
                                      Fill="Transparent"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource CompletionIconButtonStyle}"
                            Command="{Binding DataContext.CopyTh1ngTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Copy sub-th1ng text">
                        <Viewbox Width="15"
                                 Height="15"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource FeatherCopyGeometry}"
                                  Fill="Transparent"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource DangerIconButtonStyle}"
                            Command="{Binding DataContext.DeleteSubTh1ngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Delete sub-th1ng">
                        <Viewbox Width="15"
                                 Height="15"
                                 Margin="-2,-2,0,0"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource FeatherXGeometry}"
                                  Fill="Transparent"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Th1ngTemplate">
            <Grid x:Name="Th1ngDropContainer"
                  Margin="0,0,0,8"
                  ClipToBounds="False">

                <Border x:Name="Th1ngCard"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="Th1ngCardPreviewMouseLeftButtonDown"
                        PreviewMouseMove="Th1ngCardPreviewMouseMove"
                        DragOver="Th1ngCardDragOver"
                        DragLeave="Th1ngCardDragLeave"
                        Drop="Th1ngCardDrop">
                    <StackPanel>
                        <Border x:Name="Th1ngHeader"
                                Padding="16,14,16,6"
                                MinHeight="86"
                                Background="Transparent"
                                BorderThickness="0"
                                MouseLeftButtonUp="Th1ngRowMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            MinWidth="0">
                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource TimestampConverter}}"
                                               Style="{StaticResource TimestampStyle}"/>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="18">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource Th1ngTextStyle}"
                                                   TargetType="TextBlock">

                                                <Setter Property="Opacity"
                                                        Value="0.72"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.BeginEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             FontFamily="Segoe UI Variable Small"
                                             FontSize="18"
                                             Margin="0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderBrush="Transparent"
                                             BorderThickness="0"
                                             IsVisibleChanged="EditTextBoxIsVisibleChanged">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource InlineEditTextBoxStyle}"
                                                   TargetType="TextBox">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter"
                                                        Command="{Binding DataContext.SaveEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Escape"
                                                        Command="{Binding DataContext.CancelEditingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Margin"
                                                        Value="-5,3,0,0"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                 Value="True">
                                                        <Setter Property="Margin"
                                                                Value="0,3,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- TIMER -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Padding="0"
                                                    ToolTip="Start or pause timer">

                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource CompletionIconButtonStyle}"
                                                           TargetType="Button">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <Grid Width="15"
                                                      Height="15">
                                                    <Viewbox Width="15"
                                                             Height="15"
                                                             Stretch="Uniform">
                                                        <Viewbox.Style>
                                                            <Style TargetType="Viewbox">

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTimerRunning}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Viewbox.Style>
                                                        <Path Data="{StaticResource FeatherPlayGeometry}"
                                                              Fill="Transparent"
                                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Viewbox>

                                                    <Viewbox Width="15"
                                                             Height="15"
                                                             Margin="-4,-2,0,0"
                                                             Stretch="Uniform">
                                                        <Viewbox.Style>
                                                            <Style TargetType="Viewbox">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTimerRunning}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Viewbox.Style>
                                                        <Path Data="{StaticResource FeatherPauseGeometry}"
                                                              Fill="Transparent"
                                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>

                                            <TextBlock Text="{Binding ElapsedTimeText}"
                                                       MinWidth="72"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Small"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Cursor="Hand"
                                                       ToolTip="{Binding TimeCopyToolTip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin"
                                                                Value="6,0,0,0"/>
                                                        <Setter Property="Opacity"
                                                                Value="0.85"/>

                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="Opacity"
                                                                        Value="1"/>
                                                            </Trigger>

                                                            <DataTrigger Binding="{Binding IsTimeCopied}"
                                                                         Value="True">
                                                                <Setter Property="Opacity"
                                                                        Value="1"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource PrimaryTextBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                                         Value="True">
                                                                <Setter Property="Margin"
                                                                        Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>

                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.CopyTrackedTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- CLEAN SUBTH1NG SECTION INDICATOR -->
                                        <TextBlock Margin="5,5,0,0"
                                                   Text="{Binding SubTh1ngs.Count, StringFormat='SUBTH1NGS · {0}'}"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SubTh1ngs.Count}"
                                                                     Value="0">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity"
                                                    Value="0"/>
                                            <Setter Property="IsHitTestVisible"
                                                    Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Th1ngHeader}"
                                                             Value="True">
                                                    <Setter Property="Opacity"
                                                            Value="1"/>
                                                    <Setter Property="IsHitTestVisible"
                                                            Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Button Style="{StaticResource CompletionIconButtonStyle}"
                                            Command="{Binding DataContext.ToggleCompletionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Complete or reopen th1ng">
                                        <Grid Width="15"
                                              Height="15">
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     Margin="-2,-2,0,0"
                                                     Stretch="Uniform">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Path Data="{StaticResource FeatherCheckGeometry}"
                                                      Fill="Transparent"
                                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Viewbox>

                                            <Viewbox Width="15"
                                                     Height="15"
                                                     Stretch="Uniform">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Path Data="{StaticResource FeatherRotateCcwGeometry}"
                                                      Fill="Transparent"
                                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource CompletionIconButtonStyle}"
                                            Command="{Binding DataContext.CopyTh1ngTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Copy th1ng text">
                                        <Viewbox Width="15"
                                                 Height="15"
                                                 Stretch="Uniform">
                                            <Path Data="{StaticResource FeatherCopyGeometry}"
                                                  Fill="Transparent"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Button>

                                    <Button Style="{StaticResource DangerIconButtonStyle}"
                                            Command="{Binding DataContext.DeleteTh1ngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete th1ng">
                                        <Viewbox Width="15"
                                                 Height="15"
                                                 Margin="-2,-2,0,0"
                                                 Stretch="Uniform">
                                            <Path Data="{StaticResource FeatherXGeometry}"
                                                  Fill="Transparent"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Margin="10,0,8,8"
                                    Background="Transparent">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ItemsControl ItemsSource="{Binding SubTh1ngs}"
                                          ItemTemplate="{StaticResource SubTh1ngTemplate}"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"/>

                            <Button Command="{Binding DataContext.BeginAddSubTh1ngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Left"
                                    Margin="22,9,0,0"
                                    Padding="0,2"
                                    Cursor="Hand"
                                    ToolTip="Add sub-th1ng"
                                    FocusVisualStyle="{x:Null}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock Text="+ add"
                                           FontFamily="Segoe UI Variable Small"
                                           FontSize="13"
                                           FontWeight="Normal">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource MutedTextBrush}"/>
                                            <Setter Property="Opacity"
                                                    Value="0.75"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Opacity"
                                                            Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddingSubTh1ng}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="done">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border Margin="22,5,18,0"
                                    Padding="0,2,2,5"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,1">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource BorderBrush}"/>

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAddingSubTh1ng}"
                                                               Value="True"/>
                                                    <Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Value="th1ngs"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </MultiDataTrigger>

                                            <Trigger Property="IsKeyboardFocusWithin"
                                                     Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid MinHeight="32">
                                    <TextBlock Text="Add a subth1ng..."
                                               Margin="0,0,0,1"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI Variable Small"
                                               FontSize="16"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewSubTh1ngText}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding NewSubTh1ngText}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBox Text="{Binding NewSubTh1ngText,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             FontFamily="Segoe UI Variable Small"
                                             FontSize="16"
                                             CaretBrush="{StaticResource AccentBrush}"
                                             IsVisibleChanged="SubTh1ngTextBoxIsVisibleChanged"
                                             ToolTip="Write a sub-th1ng and press Enter">

                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter"
                                                        Command="{Binding DataContext.AddSubTh1ngCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                            <KeyBinding Key="Escape"
                                                        Command="{Binding DataContext.CancelAddSubTh1ngCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="TopDropIndicator"
                        Height="3"
                        Margin="12,-5,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        Panel.ZIndex="20"
                        Visibility="Collapsed"/>

                <Border x:Name="BottomDropIndicator"
                        Height="3"
                        Margin="12,0,12,-5"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        Panel.ZIndex="20"
                        Visibility="Collapsed"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- ============================================================= -->
    <!-- WINDOW                                                        -->
    <!-- ============================================================= -->

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"
                               MinHeight="0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- TITLE BAR                                             -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0"
                  Background="{StaticResource ChromeBrush}"
                  MouseLeftButtonDown="TitleBarMouseLeftButtonDown"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="8,0,0,1"
                               Text="nineth1ngs"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,6,8,6"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button Click="MinimizeClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="Minimize">
                        <Path Data="{StaticResource MinimizeGeometry}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"/>
                    </Button>

                    <Button Click="MaximizeClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="Maximize or restore">
                        <Path Data="{StaticResource MaximizeGeometry}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.2"/>
                    </Button>

                    <Button Click="CloseClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="Close">
                        <Path Data="{StaticResource CloseGeometry}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================== -->
            <!-- SECTION NAVIGATION                                    -->
            <!-- ===================================================== -->

            <Grid Grid.Row="1"
                  Margin="18,0">

                <!-- TH1NGS / DONE / SETTINGS BUTTON -->

                <Grid Style="{StaticResource MainNavigationVisibilityStyle}"
                      Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">

                        <Button Command="{Binding ShowOpenCommand}"
                                Style="{StaticResource OpenSectionButtonStyle}"
                                ToolTip="Show open th1ngs">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Viewbox Width="15"
                                         Height="15"
                                         Margin="0,0,6,0"
                                         Stretch="Uniform">
                                    <Path Data="{StaticResource FeatherListGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="TH1NGS"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="  ·  "
                                           FontSize="12"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="{Binding OpenTh1ngs.Count}"
                                           FontSize="13"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowDoneCommand}"
                                Style="{StaticResource DoneSectionButtonStyle}"
                                ToolTip="Show completed th1ngs">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Viewbox Width="15"
                                         Height="15"
                                         Margin="0,0,6,0"
                                         Stretch="Uniform">
                                    <Path Data="{StaticResource FeatherCheckCircleGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="DONE"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="  ·  "
                                           FontSize="12"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="{Binding DoneTh1ngs.Count}"
                                           FontSize="13"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ShowSettingsCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Settings">
                        <Viewbox Width="17"
                                 Height="17"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource FeatherSettingsGeometry}"
                                  Fill="Transparent"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- SETTINGS HEADER -->

                <Grid Style="{StaticResource SettingsNavigationVisibilityStyle}"
                      Height="38"
                      Margin="-6,0,0,0"
                      VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Width="30"
                                Height="30"
                                Command="{Binding BackFromSettingsCommand}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="Back">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BackBorder"
                                            Width="30"
                                            Height="30"
                                            Background="Transparent"
                                            CornerRadius="8">
                                        <Grid>
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="-6,-2,0,0"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Stretch="Uniform">
                                                <Path Data="{StaticResource FeatherChevronLeftGeometry}"
                                                      Fill="Transparent"
                                                      Stroke="{StaticResource SecondaryTextBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="BackBorder"
                                                    Property="Background"
                                                    Value="{StaticResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="SETTINGS"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Small"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- CONTENT                                               -->
            <!-- ===================================================== -->

            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Row="2"
                          MinHeight="0"
                          Padding="18,6,18,8"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          AllowDrop="True"
                          PreviewDragOver="ContentScrollViewerPreviewDragOver">
                <Grid>

                    <!-- OPEN -->

                    <Grid Style="{StaticResource OpenSectionVisibilityStyle}">
                        <TextBlock Text="Nothing is waiting."
                                   Margin="0,28"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Small"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenTh1ngs.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding OpenTh1ngs}"
                                      ItemTemplate="{StaticResource Th1ngTemplate}"
                                      Margin="0,7,0,0"/>
                    </Grid>

                    <!-- DONE -->

                    <Grid Style="{StaticResource DoneSectionVisibilityStyle}">
                        <TextBlock Text="Nothing done yet."
                                   Margin="0,28"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Small"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DoneTh1ngs.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DoneTh1ngs}"
                                      ItemTemplate="{StaticResource Th1ngTemplate}"
                                      Margin="0,7,0,0"/>
                    </Grid>

                    <!-- SETTINGS -->

                    <Grid Style="{StaticResource SettingsSectionVisibilityStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="2,12,2,20">

                                <TextBlock Text="Time tracking"
                                           FontFamily="Segoe UI Variable Display"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>

                                <TextBlock Margin="0,6,0,22"
                                           Text="Choose how tracked time is rounded and copied."
                                           TextWrapping="Wrap"
                                           FontFamily="Segoe UI Variable Small"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Billing interval"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsLabelStyle}"/>

                                    <ComboBox Grid.Column="1"
                                              Width="210"
                                              HorizontalAlignment="Right"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemsSource="{Binding BillingIntervals}"
                                              SelectedItem="{Binding BillingIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} minutes}"
                                                           FontFamily="Segoe UI Variable Small"
                                                           FontSize="14"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Round up after"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsLabelStyle}"/>

                                    <ComboBox Grid.Column="1"
                                              Width="210"
                                              HorizontalAlignment="Right"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemsSource="{Binding RoundUpThresholds}"
                                              SelectedItem="{Binding RoundUpThresholdMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} minutes}"
                                                           FontFamily="Segoe UI Variable Small"
                                                           FontSize="14"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Time format"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsLabelStyle}"/>

                                    <ComboBox Grid.Column="1"
                                              Width="210"
                                              HorizontalAlignment="Right"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              ItemsSource="{Binding OutputFormats}"
                                              SelectedItem="{Binding OutputFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Border Margin="0,24,0,0"
                                        Padding="12"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="Example"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding TimeCopyExample}"
                                                   FontFamily="Segoe UI Variable Small"
                                                   FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ===================================================== -->
            <!-- ADD NEW TH1NG                                         -->
            <!-- ===================================================== -->

            <Border Grid.Row="3"
                    Margin="18,6,18,10"
                    Padding="10,4,6,4"
                    Background="{StaticResource SurfaceBrush}"
                    Style="{StaticResource AddTh1ngAreaVisibilityStyle}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid MinHeight="34">

                    <!-- Placeholder -->

                    <TextBlock Text="Add a new th1ng..."
                               Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Small"
                               FontSize="15"
                               Foreground="{StaticResource MutedTextBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewTh1ngText}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTh1ngTextBox"
                                 Grid.Column="0"
                                 Text="{Binding NewTh1ngText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 FontFamily="Segoe UI Variable Small"
                                 FontSize="15"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 ToolTip="Write a new th1ng">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding AddTh1ngCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Command="{Binding AddTh1ngCommand}"
                                Style="{StaticResource AddButtonStyle}"
                                ToolTip="Add th1ng">
                            <Path Data="{StaticResource AddGeometry}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                   Path=Foreground}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>